{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lampion",
  "version": "1.0.0",
  "identifier": "hu.akitb.lampion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lampion",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "akitb",
    "copyright": "Copyright akitb",
    "category": "DeveloperTool",
    "homepage": "https://github.com/akitb/lampion-windows",
    "shortDescription": "Local Apache, PHP and MariaDB control panel",
    "longDescription": "Lampion runs Apache, PHP, MariaDB and phpMyAdmin on this computer from one window, with live logs, settings forms and a built-in database manager.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}